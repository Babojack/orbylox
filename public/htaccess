# Umleitungen
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Blog: serverseitig gerendert -------------------------------------
  # Muss VOR der SPA-Regel stehen. Diese Seiten liefern fertiges HTML,
  # damit Suchmaschinen den Text ohne JavaScript lesen koennen.
  RewriteRule ^sitemap\.xml$            /api/sitemap.php [L]

  # Englische Uebersicht. Muss VOR der deutschen Regel stehen, sonst greift
  # diese zuerst und /en/blog landet in der Einzelseiten-App.
  RewriteRule ^en/blog/?$               /api/blog.php?p=en/blog [L,QSA]
  RewriteRule ^en/blog/(.+?)/?$         /api/blog.php?p=en/blog/$1 [L,QSA]

  RewriteRule ^blog/?$                  /api/blog.php?p=blog [L,QSA]
  RewriteRule ^blog/(.+?)/?$            /api/blog.php?p=blog/$1 [L,QSA]

  # --- Einzelseiten-App -------------------------------------------------
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Verwaltung und API gehoeren nicht in den Suchindex
<IfModule mod_headers.c>
  <FilesMatch "\.(php)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  # ... ausser den Blogseiten, die genau dorthin sollen.
  # sitemap.php behaelt noindex: sie soll gecrawlt, aber nicht gelistet werden.
  <FilesMatch "^blog\.php$">
    Header unset X-Robots-Tag
  </FilesMatch>
</IfModule>

# Optional: Caching für statische Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>

# Alles unter /assets/ traegt einen Inhaltsstempel im Namen.
#
# WARUM ZUSAETZLICH ZU mod_expires
# `ExpiresByType` setzt nur ein Ablaufdatum. Lighthouse bemaengelte trotzdem
# die Verweildauer im Zwischenspeicher (128 KB) — der Browser fragt naemlich
# beim Neuladen sicherheitshalber nach, ob sich etwas geaendert hat. `immutable`
# sagt ihm, dass er sich das sparen kann, und genau das stimmt hier: Aendert
# sich der Inhalt, aendert sich der Dateiname. Ausserdem greift dieser Block
# auch dann, wenn mod_expires auf dem Server gar nicht geladen ist.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|webp|png|jpe?g|svg|mp3|glb)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Ueber die Leitung gehoert alles gepackt.
#
# Lighthouse rechnete allein beim JavaScript 24 KB vor, die ungepackt
# uebertragen wurden — der Server komprimiert offenbar nicht alles von selbst.
# Brotli zuerst, weil es dichter packt; wo es fehlt, springt gzip ein.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/javascript application/x-javascript application/json \
    application/xml application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/x-javascript application/json \
    application/xml application/rss+xml image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Always fetch latest index.html so new hashed assets are picked up
<Files "index.html">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</Files>
