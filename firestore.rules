rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmailLower() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : "";
    }

    function isOwner(resource) {
      return isSignedIn()
        && ('created_by' in resource.data)
        && resource.data.created_by != null
        && resource.data.created_by.lower() == authEmailLower();
    }

    function isUidOwner(resource) {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isMember(resource) {
      return isSignedIn()
        && 'members' in resource.data
        && (
          request.auth.token.email in resource.data.members
          || authEmailLower() in resource.data.members
        );
    }

    function canReadProject(resource) {
      return isUidOwner(resource) || isOwner(resource) || isMember(resource);
    }

    function canWriteProject(resource) {
      return isUidOwner(resource) || isOwner(resource);
    }

    function projectSnap(projectId) {
      return get(/databases/$(database)/documents/Project/$(projectId));
    }

    function canAccessProjectId(projectId) {
      let p = projectSnap(projectId);
      return exists(/databases/$(database)/documents/Project/$(projectId))
        && (
          (('userId' in p.data) && p.data.userId == request.auth.uid)
          || (('created_by' in p.data) && p.data.created_by != null && p.data.created_by.lower() == authEmailLower())
          || (('members' in p.data) && (request.auth.token.email in p.data.members || authEmailLower() in p.data.members))
        );
    }

    function taskSnap(taskId) {
      return get(/databases/$(database)/documents/Task/$(taskId));
    }

    function postSnap(postId) {
      return get(/databases/$(database)/documents/Post/$(postId));
    }

    function canAccessTaskId(taskId) {
      let t = taskSnap(taskId);
      return exists(/databases/$(database)/documents/Task/$(taskId))
        && ('project_id' in t.data)
        && canAccessProjectId(t.data.project_id);
    }

    function canAccessPostId(postId) {
      let p = postSnap(postId);
      return exists(/databases/$(database)/documents/Post/$(postId))
        && ('project_id' in p.data)
        && canAccessProjectId(p.data.project_id);
    }

    function isProjectScoped(data) {
      return data != null
        && ('project_id' in data)
        && data.project_id is string
        && data.project_id.size() > 0;
    }

    function projectScopedRead(resource) {
      return isSignedIn() && isProjectScoped(resource.data) && canAccessProjectId(resource.data.project_id);
    }

    function projectScopedCreate() {
      return isSignedIn() && isProjectScoped(request.resource.data) && canAccessProjectId(request.resource.data.project_id);
    }

    function projectScopedUpdate(resource) {
      return isSignedIn()
        && isProjectScoped(resource.data)
        && isProjectScoped(request.resource.data)
        && resource.data.project_id == request.resource.data.project_id
        && (
          !('userId' in resource.data)
          || (('userId' in request.resource.data) && request.resource.data.userId == resource.data.userId)
        )
        && (
          !('created_by' in resource.data)
          || (('created_by' in request.resource.data) && request.resource.data.created_by != null && resource.data.created_by != null
            && request.resource.data.created_by.lower() == resource.data.created_by.lower())
        )
        && canAccessProjectId(resource.data.project_id);
    }

    function projectScopedDelete(resource) {
      return isSignedIn() && isProjectScoped(resource.data) && canAccessProjectId(resource.data.project_id);
    }

    function taskScopedRead(resource) {
      return isSignedIn()
        && ('task_id' in resource.data)
        && resource.data.task_id is string
        && canAccessTaskId(resource.data.task_id);
    }

    function taskScopedCreate() {
      return isSignedIn()
        && ('task_id' in request.resource.data)
        && request.resource.data.task_id is string
        && canAccessTaskId(request.resource.data.task_id);
    }

    function taskScopedUpdate(resource) {
      return isSignedIn()
        && ('task_id' in resource.data)
        && ('task_id' in request.resource.data)
        && resource.data.task_id == request.resource.data.task_id
        && canAccessTaskId(resource.data.task_id);
    }

    function taskScopedDelete(resource) {
      return isSignedIn() && ('task_id' in resource.data) && canAccessTaskId(resource.data.task_id);
    }

    function postScopedRead(resource) {
      return isSignedIn()
        && ('post_id' in resource.data)
        && resource.data.post_id is string
        && canAccessPostId(resource.data.post_id);
    }

    function postScopedCreate() {
      return isSignedIn()
        && ('post_id' in request.resource.data)
        && request.resource.data.post_id is string
        && canAccessPostId(request.resource.data.post_id);
    }

    function postScopedUpdate(resource) {
      return isSignedIn()
        && ('post_id' in resource.data)
        && ('post_id' in request.resource.data)
        && resource.data.post_id == request.resource.data.post_id
        && canAccessPostId(resource.data.post_id);
    }

    function postScopedDelete(resource) {
      return isSignedIn() && ('post_id' in resource.data) && canAccessPostId(resource.data.post_id);
    }

    match /Project/{projectId} {
      allow read: if canReadProject(resource);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          !('created_by' in request.resource.data)
          || request.resource.data.created_by == request.auth.token.email
          || (
            request.resource.data.created_by != null
            && request.resource.data.created_by.lower() == authEmailLower()
          )
        );
      allow update, delete: if canWriteProject(resource);
    }

    match /Waitlist/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /Document/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /Task/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /Subtask/{docId} {
      allow read: if projectScopedRead(resource) || taskScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || taskScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || taskScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || taskScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /TaskComment/{docId} {
      allow read: if projectScopedRead(resource) || taskScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || taskScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || taskScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || taskScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /KanbanBoard/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /CanvasItem/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /CanvasConnection/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /ProductIdea/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /Post/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /PostComment/{docId} {
      allow read: if projectScopedRead(resource) || postScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || postScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || postScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || postScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /CanvasComment/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /Message/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /Event/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /FileRecord/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /Folder/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /CustomIntegration/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /StartupStep/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /StartupJourney/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /User/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /IdeaHub/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /UserProjectListPrefs/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    match /ProjectBackup/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /RestoreRequest/{docId} {
      allow read: if projectScopedRead(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if projectScopedCreate() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if projectScopedUpdate(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if projectScopedDelete(resource) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
